{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KAD-007 fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "id", "contracts", "description", "cwd", "tier", "action", "expect"],
  "properties": {
    "fixture_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*/[a-z0-9_-]+$"},
    "contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^KAD-[0-9]{3}$"}},
    "description": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "tier": {"enum": ["normal", "heavy"]},
    "requires": {"type": "array", "uniqueItems": true, "items": {"enum": ["symlink", "hardlink", "permissions", "acl", "xattr", "case_sensitive_filesystem", "case_insensitive_filesystem"]}},
    "setup": {"type": "array", "items": {"$ref": "#/$defs/setup"}},
    "assert_generated": {"type": "object", "additionalProperties": false, "required": ["metric", "value"], "properties": {"metric": {"enum": ["task_source_bytes", "yaml_document_bytes", "yaml_nodes_document", "yaml_depth", "filesystem_entries", "markdown_candidates", "scan_yaml_bytes", "scan_yaml_nodes"]}, "value": {"type": "integer", "minimum": 1}}},
    "action": {"$ref": "#/$defs/action"},
    "expect": {"$ref": "#/$defs/expect"}
  },
  "allOf": [
    {"if": {"properties": {"action": {"properties": {"op": {"const": "plan_patch"}}, "required": ["op"]}}, "required": ["action"]}, "then": {"properties": {"expect": {"properties": {"no_writes": {"const": true}}}}}},
    {"if": {"properties": {"expect": {"properties": {"result": {"const": "safe_patch_or_refusal"}}, "required": ["result"]}}, "required": ["expect"]}, "then": {"properties": {"action": {"properties": {"op": {"const": "plan_patch"}}}, "expect": {"properties": {"no_writes": {"const": true}}}}}}
  ],
  "$defs": {
    "setup": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "path"], "properties": {"op": {"const": "mkdir"}, "path": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "target"], "properties": {"op": {"enum": ["symlink", "hardlink"]}, "path": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "mode"], "properties": {"op": {"const": "chmod"}, "path": {"type": "string", "minLength": 1}, "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "base64"], "properties": {"op": {"const": "write_bytes"}, "path": {"type": "string", "minLength": 1}, "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "kind", "target"], "properties": {"op": {"const": "generate_file"}, "path": {"type": "string", "minLength": 1}, "kind": {"enum": ["task_source_bytes", "yaml_header_bytes", "yaml_node_count", "yaml_depth", "regular_file"]}, "target": {"type": "integer", "minimum": 1}, "prefix": {"type": "string"}, "repeat_byte": {"type": "integer", "minimum": 0, "maximum": 255}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "kind", "count"], "properties": {"op": {"const": "generate_family"}, "path": {"type": "string", "minLength": 1}, "kind": {"enum": ["entries", "markdown_candidates"]}, "count": {"type": "integer", "minimum": 0}, "extension": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "kind", "total"], "properties": {"op": {"const": "generate_family"}, "path": {"type": "string", "minLength": 1}, "kind": {"enum": ["yaml_bytes_total", "yaml_nodes_total"]}, "total": {"type": "integer", "minimum": 1}}}
      ]
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "properties": {
        "op": {"enum": ["scan", "validate", "resolve_config", "add", "set", "delete", "link", "repair_id", "plan_patch"]},
        "project": {"type": "string", "minLength": 1}, "tasks_root": {"type": "string", "minLength": 1},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "object", "propertyNames": {"enum": ["task_source_bytes", "yaml_document_bytes", "yaml_nodes_document", "yaml_depth", "filesystem_entries", "markdown_candidates", "scan_yaml_bytes", "scan_yaml_nodes"]}, "additionalProperties": {"type": "integer"}},
        "params": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "add"}}, "required": ["op"]}, "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/add_params"}}}},
        {"if": {"properties": {"op": {"const": "set"}}, "required": ["op"]}, "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/set_params"}}}},
        {"if": {"properties": {"op": {"const": "delete"}}, "required": ["op"]}, "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/delete_params"}}}},
        {"if": {"properties": {"op": {"const": "link"}}, "required": ["op"]}, "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/link_params"}}}},
        {"if": {"properties": {"op": {"const": "repair_id"}}, "required": ["op"]}, "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/repair_params"}}}},
        {"if": {"properties": {"op": {"const": "plan_patch"}}, "required": ["op"]}, "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/patch_params"}}}},
        {"if": {"properties": {"op": {"enum": ["scan", "validate", "resolve_config"]}}, "required": ["op"]}, "then": {"not": {"required": ["params"]}}}
      ]
    },
    "add_params": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}}},
    "set_params": {"type": "object", "additionalProperties": false, "required": ["id", "field", "value"], "properties": {"id": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}, "value": {}}},
    "delete_params": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "detach": {"type": "boolean"}}},
    "link_params": {"type": "object", "additionalProperties": false, "required": ["type", "source", "target"], "properties": {"type": {"enum": ["parent", "depends_on"]}, "source": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}},
    "repair_params": {"type": "object", "additionalProperties": false, "required": ["keep_path", "reassign"], "properties": {"keep_path": {"type": "string", "minLength": 1}, "reassign": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "id"], "properties": {"path": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}}}}},
    "patch_params": {"type": "object", "additionalProperties": false, "required": ["path", "field"], "properties": {"path": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}, "value": {}, "operation": {"enum": ["replace", "insert", "unset", "append", "remove"]}, "insertion_after": {"type": "string", "minLength": 1}, "repair": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"operation": {"const": "unset"}}, "required": ["operation"]}, "then": {"not": {"required": ["value"]}}, "else": {"required": ["value"]}}]},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["category"], "properties": {"category": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1}}},
    "document": {"type": "object", "additionalProperties": false, "required": ["path", "classification"], "properties": {"path": {"type": "string", "minLength": 1}, "classification": {"enum": ["valid", "invalid_candidate", "unsupported_schema", "non_task"]}, "id": {"type": "string", "minLength": 1}}},
    "readiness": {"type": "object", "additionalProperties": false, "required": ["id", "result"], "properties": {"id": {"type": "string", "minLength": 1}, "result": {"enum": ["ready", "blocked", "unresolved"]}}},
    "expect": {
      "type": "object", "additionalProperties": false, "required": ["result", "no_writes"],
      "properties": {
        "result": {"enum": ["ok", "diagnostic", "refused", "scan_incomplete", "unsupported_schema", "config_error", "safe_patch_or_refusal"]},
        "no_writes": {"type": "boolean"}, "scan_complete": {"type": "boolean"},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "ordered_diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "readiness": {"type": "array", "items": {"$ref": "#/$defs/readiness"}},
        "ready_selection": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "quarantined_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "history_markers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unchanged": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "absent": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unchanged_spans": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "next_id": {"type": "string", "minLength": 1},
        "fields": {"type": "object", "additionalProperties": {"type": "object"}},
        "custom_types": {"type": "object", "additionalProperties": {"enum": ["string", "integer", "float", "boolean", "null", "sequence", "mapping", "float_nan", "float_positive_infinity", "float_negative_infinity"]}},
        "relationships": {"type": "object", "additionalProperties": false, "properties": {"parents": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["child", "parent"], "properties": {"child": {"type": "string", "minLength": 1}, "parent": {"type": "string", "minLength": 1}}}}, "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["task", "target"], "properties": {"task": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}}}}},
        "cycle_members": {"type": "object", "additionalProperties": false, "properties": {"parent": {"type": "array", "uniqueItems": true, "items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "dependency": {"type": "array", "uniqueItems": true, "items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
        "goldens": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "proposed_goldens": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "before_file_access": {"type": "boolean"}, "normal_partial_results": {"type": "boolean"}, "allow_additional_diagnostics": {"type": "boolean"}
      }
    }
  }
}
