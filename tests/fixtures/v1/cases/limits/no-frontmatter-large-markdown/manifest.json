{
  "fixture_version": 1,
  "id": "limits/no-frontmatter-large-markdown",
  "contracts": [
    "KAD-006"
  ],
  "description": "Ordinary Markdown lacking initial delimiter is non-task without reading full file",
  "cwd": "project",
  "tier": "normal",
  "setup": [
    {
      "op": "generate_file",
      "kind": "regular_file",
      "path": "project/tasks/NOTES.md",
      "target": 16777217,
      "prefix": "# No frontmatter\n",
      "repeat_byte": 65
    }
  ],
  "action": {
    "op": "scan"
  },
  "expect": {
    "no_writes": true,
    "result": "ok",
    "scan_complete": true,
    "documents": [
      {
        "path": "tasks/NOTES.md",
        "classification": "non_task"
      }
    ]
  }
}
